<?xml version="1.0" encoding="UTF-8"?>
<!-- Phase 3: time-varying demand to exercise the hybrid scheduler's regime switching.
     0-120 s light and even; 120-240 s rush hour concentrated on north/east; 240-360 s moderate and balanced. -->
<routes>
    <vType id="car" vClass="passenger" length="5" accel="2.6" decel="4.5" maxSpeed="13.89" />
    <vType id="truck" vClass="truck" length="9" accel="1.3" decel="4.0" maxSpeed="11.11" />
    <vType id="motorcycle" vClass="motorcycle" length="2.2" accel="3.0" decel="5.0" maxSpeed="13.89" />
    <route id="north_south" edges="north_in south_out" />
    <route id="south_north" edges="south_in north_out" />
    <route id="east_west" edges="east_in west_out" />
    <route id="west_east" edges="west_in east_out" />
    <flow id="off_n" type="car" route="north_south" begin="0" end="120" probability="0.04" />
    <flow id="off_s" type="car" route="south_north" begin="0" end="120" probability="0.04" />
    <flow id="off_e" type="motorcycle" route="east_west" begin="0" end="120" probability="0.04" />
    <flow id="off_w" type="car" route="west_east" begin="0" end="120" probability="0.04" />
    <flow id="rush_n_cars" type="car" route="north_south" begin="120" end="240" probability="0.20" />
    <flow id="rush_n_trucks" type="truck" route="north_south" begin="120" end="240" probability="0.04" />
    <flow id="rush_e_cars" type="car" route="east_west" begin="120" end="240" probability="0.12" />
    <flow id="rush_s_cars" type="car" route="south_north" begin="120" end="240" probability="0.04" />
    <flow id="rush_w_bikes" type="motorcycle" route="west_east" begin="120" end="240" probability="0.04" />
    <flow id="mid_n" type="car" route="north_south" begin="240" end="360" probability="0.08" />
    <flow id="mid_s" type="car" route="south_north" begin="240" end="360" probability="0.08" />
    <flow id="mid_e" type="car" route="east_west" begin="240" end="360" probability="0.08" />
    <flow id="mid_w" type="car" route="west_east" begin="240" end="360" probability="0.08" />
    <flow id="mid_trucks" type="truck" route="south_north" begin="240" end="360" probability="0.02" />
</routes>
